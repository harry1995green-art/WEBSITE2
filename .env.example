DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"
CRM_API_KEY="replace-with-a-long-random-api-key"

# Where survey photos are stored. In production, point this at a mounted
# persistent volume (e.g. "/data/uploads" on Railway).
UPLOAD_DIR="public/uploads"

# Used only by prisma/seed.ts to create the first login user.
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Your Name"
ADMIN_PASSWORD="choose-a-strong-password"
