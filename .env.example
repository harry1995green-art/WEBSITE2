DATABASE_URL="postgresql://user:password@localhost:5432/artisanic_crm"
# A direct (non-pooled) connection, used only by `prisma migrate`. On Neon
# (e.g. via Vercel), this is auto-set as DATABASE_URL_UNPOOLED — copy that
# value here, or just use the same value as DATABASE_URL for local dev /
# hosts without connection pooling.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/artisanic_crm"
SESSION_SECRET="replace-with-a-long-random-string"
CRM_API_KEY="replace-with-a-long-random-api-key"

# Where survey photos are stored when BLOB_READ_WRITE_TOKEN isn't set. In
# production without Vercel Blob, point this at a mounted persistent volume
# (e.g. "/data/uploads" on Railway/Render/Fly).
UPLOAD_DIR="public/uploads"

# Set automatically by Vercel when you connect Blob storage to the project.
# Leave unset for local dev / other hosts (falls back to UPLOAD_DIR).
# BLOB_READ_WRITE_TOKEN=""

# Used to create/update the login user (by prisma/seed.ts and on every boot).
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Your Name"
ADMIN_PASSWORD="choose-a-strong-password"
